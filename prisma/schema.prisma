generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }

enum Direction { LONG SHORT FLAT }
enum MarketBias { BULLISH BEARISH NEUTRAL MIXED }
enum MarketType { TREND NORMAL_VARIATION NEUTRAL DOUBLE_DISTRIBUTION FAILED_AUCTION BALANCE UNKNOWN }
enum ScreenshotKind { BEFORE ENTRY DURING EXIT POST_ANALYSIS SETUP_EXAMPLE }

model User { id String @id @default(cuid()) name String @default("Trader") createdAt DateTime @default(now()) tradingDays TradingDay[] notes Note[] setups Setup[] }
model TradingDay { id String @id @default(cuid()) userId String date DateTime @unique instrument String pnl Float @default(0) tradeCount Int @default(0) executionScore Int @default(0) dailyBias MarketBias @default(NEUTRAL) marketCondition String? emotionalState String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId], references:[id]) dailyOps DailyOps? trades Trade[] timelineEvents TimelineEvent[] emotions Emotion[] screenshots Screenshot[] reviews Review[] marketConditionRecord MarketCondition? }
model DailyOps { id String @id @default(cuid()) tradingDayId String @unique macroContext String? economicEvents String? vixCondition String? previousDayAnalysis String? overnightAnalysis String? currentInventory String? marketStructure String? hvn String? lvn String? poc String? valueAreaHigh Float? valueAreaLow Float? initialBalance String? importantLevels String? expectedScenarios String? invalidationPoints String? scenario1Description String? scenario1EntryIdea String? scenario1Confirmation String? scenario1Target String? scenario1Invalidation String? scenario2Description String? scenario2EntryIdea String? scenario2Confirmation String? scenario2Target String? scenario2Invalidation String? actualMarketType MarketType @default(UNKNOWN) expectedVsActual String? tradingDay TradingDay @relation(fields:[tradingDayId], references:[id], onDelete:Cascade) }
model Trade { id String @id @default(cuid()) tradingDayId String time DateTime instrument String direction Direction entryPrice Float exitPrice Float? stopLoss Float? target Float? quantity Int risk Float? reward Float? rMultiple Float? pnl Float @default(0) commission Float @default(0) session String? setupId String? marketContext String? confidenceScore Int @default(0) executionQuality Int @default(0) tags String @default("[]") createdAt DateTime @default(now()) tradingDay TradingDay @relation(fields:[tradingDayId], references:[id], onDelete:Cascade) setup Setup? @relation(fields:[setupId], references:[id]) mistakes Mistake[] screenshots Screenshot[] }
model Screenshot { id String @id @default(cuid()) tradingDayId String? tradeId String? setupId String? kind ScreenshotKind filePath String annotationsJson String? createdAt DateTime @default(now()) tradingDay TradingDay? @relation(fields:[tradingDayId], references:[id], onDelete:Cascade) trade Trade? @relation(fields:[tradeId], references:[id], onDelete:Cascade) setup Setup? @relation(fields:[setupId], references:[id], onDelete:Cascade) }
model TimelineEvent { id String @id @default(cuid()) tradingDayId String timestamp DateTime title String body String? tags String @default("[]") tradingDay TradingDay @relation(fields:[tradingDayId], references:[id], onDelete:Cascade) }
model Note { id String @id @default(cuid()) userId String title String category String contentJson String contentText String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId], references:[id]) }
model Setup { id String @id @default(cuid()) userId String name String @unique description String? rules String? entryCriteria String? exitCriteria String? winRate Float @default(0) averageR Float @default(0) createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) trades Trade[] screenshots Screenshot[] }
model Mistake { id String @id @default(cuid()) name String @unique description String? lossImpact Float @default(0) trades Trade[] }
model Emotion { id String @id @default(cuid()) tradingDayId String sleepQuality Int? focus Int? stress Int? confidence Int? energy Int? satisfaction Int? fear Int? anger Int? revengeTrading Boolean @default(false) tradingDay TradingDay @relation(fields:[tradingDayId], references:[id], onDelete:Cascade) }
model MarketCondition { id String @id @default(cuid()) tradingDayId String @unique marketType MarketType openLocation String? valueRelationship String? overnightInventory String? auctionResult String? trendBalanceCondition String? searchableSummary String? tradingDay TradingDay @relation(fields:[tradingDayId], references:[id], onDelete:Cascade) }
model Review { id String @id @default(cuid()) tradingDayId String? period String summary String lessons String? score Int @default(0) createdAt DateTime @default(now()) tradingDay TradingDay? @relation(fields:[tradingDayId], references:[id]) }
model Report { id String @id @default(cuid()) period String dateFrom DateTime dateTo DateTime filePath String? payloadJson String createdAt DateTime @default(now()) }
